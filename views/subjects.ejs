<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subjects | Shule Bora</title>
     <link rel="stylesheet" href="/main.css">
  </head>
  <body>
    <%- include("_header.ejs")  %>
    <main class="page-shell"><div class="page-intro"><div><span class="eyebrow">Academic structure</span><h1>Subjects</h1><p>Organise the subjects your learners study.</p></div></div>
    <form class="panel" action="/add-subject" method="post" >
      <h2> Add New Subject</h2>
      <div class="form-grid"><div class="field"><label for="subject_name">Subject Name</label><input type="text" id="subject_name" name="subject_name" required /></div>
      <div class="field"><label for="subject_code">Subject Code</label><input type="text" id="subject_code" name="subject_code" required /></div>
      <div class="field"><label for="category">Category</label><select name="category" id="category">
        <option value="Science">Science</option>
        <option value="Arts">Arts</option>
        <option value="Mathematics">Mathematics</option>
        <option value="Languages">Languages</option>
      </select></div><div class="form-submit"><button class="button" type="submit">Add subject</button></div></div>
    </form>
    <ul class="subject-list">
    <%  subjects.forEach(subject=>{ %>
      <li class="subject-item">
        <h3><%= subject.subject_name %></h3>
        <p>Subject ID: <%= subject.subject_id %></p><p>Code: <%= subject.subject_code %></p><p>Category: <%= subject.category %></p>
      </li>
    <% }) %>
    </ul></main>
  </body>
</html>
